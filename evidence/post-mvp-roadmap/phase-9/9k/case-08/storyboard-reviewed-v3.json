{"approved_script_version":2,"duration_target":"45–60 giây","human_approved":false,"native_project_id":"df21ef39df655f88865bee6563cf23cb","native_project_revision_before_media":3,"production_dispatched":false,"proposed_proposal_sha256":"355cf6705e6818f05b215e74d96ff0c517eec89f34639eaf72e941342e947e17","scenes":[{"asset_sha256":"14fb9ef934ec6a318f92f12188e6d49b9e7224b9a51dcc1bb813836ec88fdc40","duration_status":"WAITING_FOR_MEASURED_VOICE","human_approved":false,"narration_excerpt":"Nguồn cung tăng, nhưng giao dịch lại giảm: đọc thị trường thế nào cho đúng? Cùng nhìn lại quý II năm 2026.","narration_is_unchanged_approved_script_excerpt":true,"on_screen_text":"Nhìn lại thị trường quý II/2026","production_options":{"crop_strategy":"contain","motion":"none","source_start":0,"transition":"fade"},"proposed_asset_id":"phase9k-08-scene-01-graphic-v1","scene":1,"source_references":[{"content_sha256":"2712b47763da0b41b1475561a705bbc47040b230c9b0883862d05d89d0fd23cd","id":"33fafed7b0524ae9b5f3d899b828b097","reference":"https://baochinhphu.vn/giao-dich-giam-ton-kho-bat-dong-san-tang-trong-quy-ii-2026-102260821161433075.htm"}],"visual":"Đồ họa chữ/số liệu tự tạo; giữ toàn khung, không chuyển động; DỮ LIỆU KỲ BÁO CÁO"},{"asset_sha256":"0ad49647980c1191d0ac92ae7fd41db50e96f59bf03af93f763615f289a3e6ff","duration_status":"WAITING_FOR_MEASURED_VOICE","human_approved":false,"narration_excerpt":"Theo bài trên Báo Điện tử Chính phủ đăng ngày 21 tháng 8 năm 2026, nguồn cung tiếp tục tăng, giao dịch giảm và tồn kho có xu hướng tăng nhẹ.","narration_is_unchanged_approved_script_excerpt":true,"on_screen_text":"Nguồn cung · Giao dịch · Tồn kho","production_options":{"crop_strategy":"contain","motion":"none","source_start":0,"transition":"fade"},"proposed_asset_id":"phase9k-08-scene-02-graphic-v1","scene":2,"source_references":[{"content_sha256":"2712b47763da0b41b1475561a705bbc47040b230c9b0883862d05d89d0fd23cd","id":"33fafed7b0524ae9b5f3d899b828b097","reference":"https://baochinhphu.vn/giao-d