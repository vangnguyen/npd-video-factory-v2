* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Human review receipts bind exact file bytes, including Windows line endings.
evidence/post-mvp-roadmap/phase-8/*.json -text whitespace=cr-at-eol
evidence/post-mvp-roadmap/phase-8/review-bundle.md -text whitespace=cr-at-eol
evidence/post-mvp-roadmap/phase-8/final-review-bundle.md -text whitespace=cr-at-eol
evidence/post-mvp-roadmap/phase-9/*.json -text whitespace=cr-at-eol
evidence/post-mvp-roadmap/phase-9/*review*.md -text whitespace=cr-at-eol,-blank-at-eof
evidence/post-mvp-roadmap/phase-9/9k/** -text whitespace=cr-at-eol,-blank-at-eof

# Phase 10 UAT receipts and media hashes also bind exact captured bytes.
evidence/post-mvp-roadmap/phase-10/final-uat/** -text whitespace=cr-at-eol,-blank-at-eof
# FFmpeg's captured progress lines include padding; retain their original bytes.
evidence/post-mvp-roadmap/phase-10/final-uat/**/*.log -text whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol

# UX remediation captures are append-only receipts with exact raw hashes.
evidence/post-mvp-roadmap/phase-10/studio-ux-02/** -text whitespace=cr-at-eol,-blank-at-eof
evidence/post-mvp-roadmap/phase-10/studio-ux-02/**/*.log -text whitespace=cr-at-eol,-blank-at-eof,-blank-at-eol
