{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngocphuongdong.com/schemas/video-factory/v3-01/flow-a-real-media-run-reference.schema.json",
  "title": "V3-01 Flow A real-media run reference template",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "status", "slot", "asr_reference", "visual_source", "expected_scene_boundaries_seconds", "expected_subject_reframe_zones", "expected_subtitle_cues", "expected_output_duration_seconds", "blocked_by", "acceptance_effect"],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "flow_a_real_media_run_reference"},
    "status": {"const": "PREPARED_NOT_EXECUTED"},
    "slot": {"type": "integer", "minimum": 1, "maximum": 2},
    "asr_reference": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_path", "asset_sha256", "duration_seconds", "transcript_path", "transcript_sha256", "critical_terms", "rights_record_path"],
      "properties": {
        "asset_path": {"type": "string"},
        "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "duration_seconds": {"type": "number", "minimum": 90, "maximum": 180},
        "transcript_path": {"type": "string"},
        "transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "critical_terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "rights_record_path": {"type": "string"}
      }
    },
    "visual_source": {"type": "null"},
    "expected_scene_boundaries_seconds": {"type": "null"},
    "expected_subject_reframe_zones": {"type": "null"},
    "expected_subtitle_cues": {"type": "null"},
    "expected_output_duration_seconds": {"type": "null"},
    "blocked_by": {
      "type": "array", "minItems": 4, "uniqueItems": true,
      "items": {"enum": ["OWNER_CLEARED_VIDEO_NOT_BOUND", "SCENE_REFERENCE_NOT_ANNOTATED", "SUBJECT_REFRAME_REFERENCE_NOT_ANNOTATED", "SUBTITLE_REFERENCE_NOT_ANNOTATED", "OUTPUT_DURATION_NOT_BOUND", "G04_NOT_APPROVED", "G11_NOT_APPROVED"]}
    },
    "acceptance_effect": {"const": "NONE"}
  }
}
