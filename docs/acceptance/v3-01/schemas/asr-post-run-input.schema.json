{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngocphuongdong.com/schemas/video-factory/v3-01/asr-post-run-input.schema.json",
  "title": "V3-01 ASR post-run evaluator input",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "record_kind", "operation", "binding", "reference", "provider_transcript", "receipts"],
  "properties": {
    "schema_version": {"const": 1},
    "record_kind": {"const": "asr_post_run_evaluation_input"},
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "provider_execution", "status", "consumed", "attempts", "retry_count", "fallback_count"],
      "properties": {
        "operation_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,199}$"},
        "provider_execution": {"enum": ["SUCCESS", "FAILED", "BLOCKED_PRE_CALL"]},
        "status": {"enum": ["SUCCEEDED", "FAILED", "BLOCKED", "NOT_STARTED"]},
        "consumed": {"type": "boolean"},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 1},
        "retry_count": {"const": 0},
        "fallback_count": {"const": 0}
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rc_tag", "rc_commit", "provider", "model", "capability", "language", "asset_sha256", "asset_duration_seconds", "rights_record_id", "rights_record_sha256"],
      "properties": {
        "rc_tag": {"type": "string", "minLength": 1},
        "rc_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "capability": {"const": "asr"},
        "language": {"const": "vi"},
        "asset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "asset_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
        "rights_record_id": {"type": "string", "minLength": 1},
        "rights_record_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transcript", "transcript_path", "transcript_sha256", "critical_terms"],
      "properties": {
        "transcript": {"type": "string", "minLength": 1},
        "transcript_path": {"type": "string", "minLength": 1},
        "transcript_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "critical_terms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "provider_transcript": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["text", "language", "confidence", "provider_duration_seconds", "segments", "provenance", "actual_cost_vnd"],
          "properties": {
            "text": {"type": "string", "minLength": 1},
            "language": {"type": "string", "minLength": 1},
            "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
            "provider_duration_seconds": {"type": "number", "exclusiveMinimum": 0},
            "segments": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/segment"}
            },
            "provenance": {"$ref": "#/$defs/provenance"},
            "actual_cost_vnd": {"type": ["string", "null"], "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"}
          }
        }
      ]
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage_or_duration_receipt_present", "cost_receipt_present", "reservation_vnd", "post_reconciliation_reserved_vnd", "ledger", "circuit", "duplicate_protection", "secret_scan", "evidence_sha256"],
      "properties": {
        "usage_or_duration_receipt_present": {"type": "boolean"},
        "cost_receipt_present": {"type": "boolean"},
        "reservation_vnd": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"},
        "post_reconciliation_reserved_vnd": {"type": "string", "pattern": "^[0-9]+(?:\\.[0-9]{1,6})?$"},
        "ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["operations", "attempts", "budget_days", "circuits"],
          "properties": {
            "operations": {"type": "integer", "minimum": 0},
            "attempts": {"type": "integer", "minimum": 0},
            "budget_days": {"type": "integer", "minimum": 0},
            "circuits": {"type": "integer", "minimum": 0}
          }
        },
        "circuit": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "consecutive_failures"],
          "properties": {
            "state": {"enum": ["closed", "open", "half_open", "unknown"]},
            "consecutive_failures": {"type": "integer", "minimum": 0}
          }
        },
        "duplicate_protection": {"enum": ["DUPLICATE_OPERATION_BLOCKED", "NOT_TESTED", "FAILED"]},
        "secret_scan": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "finding_count"],
          "properties": {
            "status": {"enum": ["PASS", "FAIL", "NOT_TESTED"]},
            "finding_count": {"type": "integer", "minimum": 0}
          }
        },
        "evidence_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "text", "confidence"],
      "properties": {
        "start_seconds": {"type": "number"},
        "end_seconds": {"type": "number"},
        "text": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_seconds", "end_seconds", "text", "speaker", "confidence", "words"],
      "properties": {
        "start_seconds": {"type": "number"},
        "end_seconds": {"type": "number"},
        "text": {"type": "string", "minLength": 1},
        "speaker": {"type": ["string", "null"]},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "words": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/word"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_request_id", "request_sha256", "response_sha256", "latency_ms", "timestamp_source", "original_evidence", "secret_recorded"],
      "properties": {
        "provider_request_id": {"type": ["string", "null"], "minLength": 1},
        "request_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "response_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "timestamp_source": {"type": ["string", "null"]},
        "original_evidence": {"type": "boolean"},
        "secret_recorded": {"type": "boolean"}
      }
    }
  }
}
