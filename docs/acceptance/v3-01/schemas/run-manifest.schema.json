{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ngocphuongdong.com/schemas/video-factory/v3-01/run-manifest.schema.json",
  "title": "Video Factory V3-01 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "started_at_utc", "completed_at_utc", "repository", "commit_sha", "base_sha", "release_candidate", "environment", "container_images", "database_migration_version", "config_fingerprint_redacted", "providers", "test_cases", "artifact_manifest", "cost_summary", "gap_ids", "owner_gate_ids", "result"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^vf-v3-01-[a-zA-Z0-9._-]+$"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "release_candidate": {"type": "string", "minLength": 1},
    "environment": {"enum": ["LOCAL", "CI", "STAGING", "PROD-CANARY"]},
    "container_images": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name", "digest"], "properties": {"name": {"type": "string"}, "digest": {"type": "string"}}}},
    "database_migration_version": {"type": "string", "minLength": 1},
    "config_fingerprint_redacted": {"type": "string", "minLength": 1},
    "providers": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["capability", "provider", "model_or_workflow", "region", "credential_alias", "secret_recorded"], "properties": {"capability": {"type": "string"}, "provider": {"type": "string"}, "model_or_workflow": {"type": "string"}, "region": {"type": "string"}, "credential_alias": {"type": "string"}, "secret_recorded": {"const": false}}}},
    "test_cases": {"type": "array", "items": {"type": "string"}},
    "artifact_manifest": {"type": "array", "items": {"type": "string"}},
    "cost_summary": {"type": "object"},
    "gap_ids": {"type": "array", "items": {"type": "string", "pattern": "^V3-01-GAP-[0-9]{3}$"}},
    "owner_gate_ids": {"type": "array", "items": {"type": "string", "pattern": "^G-[0-9]{2}$"}},
    "result": {"enum": ["PASS", "FAIL", "BLOCKED"]}
  }
}
