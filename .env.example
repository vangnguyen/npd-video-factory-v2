# NPD Video Factory V2 — safe local/CI defaults. Never commit real credentials.
APP_ENV=development
VIDEO_API_BIND=127.0.0.1
VIDEO_API_PORT=8000
VIDEO_RENDERER_BIND=127.0.0.1
VIDEO_RENDERER_PORT=3001
VIDEO_STUDIO_BIND=127.0.0.1
VIDEO_STUDIO_PORT=3000
PUBLIC_BASE_URL=http://localhost:8000

# V2-owned PostgreSQL metadata/state database. Local-only example values.
VIDEO_POSTGRES_USER=video_factory
VIDEO_POSTGRES_PASSWORD=development-only
VIDEO_POSTGRES_DB=video_factory
DATABASE_URL=postgresql+asyncpg://video_factory:development-only@postgres:5432/video_factory

# V2 owns this Redis container and DB. It is not shared with AgentHub.
REDIS_URL=redis://redis:6379/0
JOB_STORAGE_ROOT=/workspace/storage/jobs
ASSET_STORAGE_ROOT=/workspace/storage/assets
OBJECT_STORAGE_PROVIDER=s3
OBJECT_STORAGE_ENDPOINT_URL=http://minio:9000
OBJECT_STORAGE_BUCKET=npd-video-factory-v2
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=video-factory-dev
OBJECT_STORAGE_SECRET_KEY=video-factory-dev-only-change-me
OBJECT_STORAGE_AUTO_CREATE_BUCKET=true
OBJECT_STORAGE_LOCAL_ROOT=/workspace/storage/object-store
VIDEO_MANIFEST_SCHEMA_PATH=/workspace/packages/contracts/video-manifest.schema.json
RENDERER_URL=http://renderer:3001
RENDERER_TIMEOUT_SECONDS=600

VIDEO_FACTORY_BRAND_NAME=NPD Video Factory
VIDEO_FACTORY_LOGO_PATH=/workspace/storage/assets/brand/default-logo.png
PILOT_STRICT_ASSETS=false
DEFAULT_WORKSPACE_SLUG=npd-local
DEFAULT_WORKSPACE_NAME=NPD Local Workspace
DEFAULT_WORKSPACE_OWNER_REF=local-owner

# Deterministic, synthetic, legal fixture provider for development and CI only.
# Set false before any production deployment. Live provider contracts remain not_configured.
TREND_FIXTURE_ENABLED=true
TREND_FIXTURE_PATH=/app/app/fixtures/trend-signals.json

# V2-04 deterministic Auto Edit fixtures. Disable in production. The contract-only
# transcription provider returns not_configured until a live provider is owner-approved.
AUTO_EDIT_FIXTURE_ENABLED=true
TRANSCRIPTION_PROVIDER=fixture
AUTO_EDIT_SIGNAL_PROVIDER=fixture
FFPROBE_PATH=ffprobe
FFMPEG_PATH=ffmpeg
UPLOAD_STAGING_ROOT=/workspace/storage/uploads
ANALYSIS_STAGING_ROOT=/workspace/storage/analysis
UPLOAD_DEFAULT_PART_SIZE_BYTES=8388608
UPLOAD_MAX_PART_SIZE_BYTES=33554432
UPLOAD_MAX_SIZE_BYTES=2000000000

# V2-05 structured Vision fixture for local/CI only. A live Vision adapter remains
# not_configured until credentials and one paid/manual acceptance run are owner-approved.
VISION_FIXTURE_ENABLED=true
VISION_PROVIDER=fixture
VISION_STAGING_ROOT=/workspace/storage/vision

# V2-06 Media Intelligence uses deterministic, copyright-safe fixtures in
# local/CI only. Production must set MEDIA_FIXTURE_ENABLED=false and use
# contract/not_configured providers until an owner-approved adapter is ready.
MEDIA_FIXTURE_ENABLED=true
STOCK_MEDIA_PROVIDER=fixture
IMAGE_GENERATION_PROVIDER=fixture
VIDEO_GENERATION_PROVIDER=fixture
MEDIA_STAGING_ROOT=/workspace/storage/media-resolution
PREVIEW_STAGING_ROOT=/workspace/storage/previews
PREVIEW_DOWNLOAD_ROOT=/workspace/storage/preview-downloads
PRODUCTION_RENDER_STAGING_ROOT=/workspace/storage/production-renders
PRODUCTION_RENDER_DOWNLOAD_ROOT=/workspace/storage/production-downloads
MEDIA_EXTERNAL_EXECUTION_ENABLED=false
MEDIA_PAID_EXECUTION_ENABLED=false

# Optional ComfyUI bridge. The service is behind the `gpu` Compose profile and
# remains disabled until the owner provisions approved models/workflows.
COMFYUI_BRIDGE_URL=http://comfyui-bridge:8011
COMFYUI_EXECUTION_ENABLED=false
COMFYUI_BRIDGE_TIMEOUT_SECONDS=300
COMFYUI_IMAGE_WORKFLOW_ID=npd-text-to-image-v1
COMFYUI_VIDEO_WORKFLOW_ID=npd-video-generation-v1
COMFYUI_WORKFLOW_MANIFEST=/workspace/workflows/comfyui/manifest.json
COMFYUI_BACKEND=disabled

# Offline deterministic provider for dev/CI. External TTS is manual only.
TTS_PROVIDER=espeak
ESPEAK_VOICE=vi
ESPEAK_RATE=145
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_BASE_URL=https://api.openai.com

# V2-08 version-bound audio/subtitle/final-render pipeline. `espeak` is the
# offline CI/dev adapter. Any external TTS call is separately owner-gated.
AUDIO_TTS_PROVIDER=espeak
AUDIO_EXTERNAL_EXECUTION_ENABLED=false
AUDIO_TTS_VOICE=vi
AUDIO_TTS_RATE=145
RENDERER_TIMEOUT_SECONDS=600

# V2-09 Publishing dry-run. The first flag remains the public owner gate;
# external execution also requires both separate gates below. Official OAuth
# material belongs in an encrypted external secret store; only opaque refs may
# be configured here and all adapters remain contract-only in V2-09.
PUBLISH_ENABLED=false
PUBLISH_EXTERNAL_EXECUTION_ENABLED=false
PUBLISH_OWNER_GATE_ENABLED=false
PUBLISHING_CREDENTIAL_STORE=external
YOUTUBE_PUBLISHING_CREDENTIAL_REF=
TIKTOK_PUBLISHING_CREDENTIAL_REF=
INSTAGRAM_PUBLISHING_CREDENTIAL_REF=
FACEBOOK_PUBLISHING_CREDENTIAL_REF=
HUMAN_APPROVAL_REQUIRED=true

# V2-10 Analytics + Learning. Fixture metrics are synthetic and allowed only
# in development/CI. Official analytics adapters remain contract-only: even an
# external secret reference does not enable a network call in V2-10.
ANALYTICS_FIXTURE_ENABLED=true
ANALYTICS_EXTERNAL_EXECUTION_ENABLED=false
ANALYTICS_SCHEDULED_REFRESH_ENABLED=false
ANALYTICS_MAX_ATTEMPTS=3
ANALYTICS_RETRY_BASE_SECONDS=30
ANALYTICS_RETRY_MAX_SECONDS=900
YOUTUBE_ANALYTICS_CREDENTIAL_REF=
TIKTOK_ANALYTICS_CREDENTIAL_REF=
INSTAGRAM_ANALYTICS_CREDENTIAL_REF=
FACEBOOK_ANALYTICS_CREDENTIAL_REF=

# V2-11 Agent Hub bridge. The bridge is optional and fail-closed. The JSON key
# file is provisioned out of band with mode 0400/0440; it is never committed,
# copied into an image or returned by an API. `fixture` is local/CI only.
AGENT_HUB_BRIDGE_ENABLED=false
AGENT_HUB_SERVICE_KEYS_FILE=/run/secrets/video-factory-agent-hub.json
AGENT_HUB_WEBHOOK_SIGNING_KEYS_FILE=/run/secrets/video-factory-agent-hub.json
AGENT_HUB_WEBHOOK_MODE=disabled
AGENT_HUB_WEBHOOK_DESTINATION_REF=agent-hub
AGENT_HUB_WEBHOOK_URL=
AGENT_HUB_WEBHOOK_ALLOWED_HOSTS=mkt.ngocphuongdong.com
AGENT_HUB_WEBHOOK_EXTERNAL_DELIVERY_ENABLED=false
AGENT_HUB_WEBHOOK_TIMEOUT_SECONDS=10
AGENT_HUB_WEBHOOK_MAX_ATTEMPTS=3
AGENT_HUB_WEBHOOK_RETRY_BASE_SECONDS=30
AGENT_HUB_WEBHOOK_RETRY_MAX_SECONDS=900
SERVICE_AUTH_MAX_CLOCK_SKEW_SECONDS=300
SERVICE_AUTH_REPLAY_TTL_SECONDS=600
