[Unit]
Description=Video Factory privileged systemd credential resolver
Requires=npd-vf-secret-resolver.socket
After=npd-vf-secret-resolver.socket
ConditionPathExists=/etc/npd-video-factory/provider-secret-resolver-policy.json
ConditionPathExists=/etc/npd-video-factory/provider-secret-resolver-policy.sha256
ConditionPathExists=/etc/npd-video-factory/runtime-activation.json
ConditionPathExists=/etc/npd-video-factory/runtime-activation.sha256

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/npd-video-factory/runtime/venv/bin/python -I /opt/npd-video-factory/runtime/provider-secret-resolver.py
LoadCredentialEncrypted=openai-codex-video:/etc/credstore.encrypted/openai-codex-video
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
ReadOnlyPaths=/etc/npd-video-factory /etc/credstore.encrypted
ReadWritePaths=/var/lib/npd-video-factory/executor/secret-resolution
RuntimeDirectory=npd-video-factory
RuntimeDirectoryMode=0755
StandardOutput=journal
StandardError=journal
