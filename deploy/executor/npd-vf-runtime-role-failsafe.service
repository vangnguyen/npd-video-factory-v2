[Unit]
Description=Video Factory PostgreSQL runtime-role expiry failsafe
After=npd-vf-provider-custody-postgresql.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/npd-video-factory/runtime/venv/bin/python -I /opt/npd-video-factory/runtime/runtime-activation.py expire
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/npd-video-factory /opt/npd-video-factory/runtime
ReadWritePaths=/run/npd-video-factory
RestrictAddressFamilies=AF_UNIX
