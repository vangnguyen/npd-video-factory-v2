FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg espeak-ng \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /workspace
COPY apps/api /workspace/apps/api
COPY services/worker /workspace/services/worker
COPY packages/contracts /workspace/packages/contracts
COPY deploy/profiles/runtime.py /opt/video-factory/runtime.py
RUN pip install --no-cache-dir /workspace/apps/api /workspace/services/worker \
    && useradd --uid 10001 --create-home video-factory \
    && mkdir -p /workspace/storage /workspace/backups \
    && chown 10001:10001 /workspace/storage /workspace/backups
USER 10001:10001
WORKDIR /workspace/apps/api
ENTRYPOINT ["python", "/opt/video-factory/runtime.py"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
